	<scene name="scene_img360_1" title="img360-1" onstart="" thumburl="panos/img360_1.tiles/thumb.jpg" lat="" lng="" alt="" heading="">
		
		<control bouncinglimits="calc:image.cube ? true : false" />

		<view hlookat="0.0" vlookat="0.0" fovtype="MFOV" fov="120" maxpixelzoom="2.0" fovmin="70" fovmax="140" limitview="auto" />

		<preview url="panos/img360_1.tiles/preview.jpg" />

		<image>
			<cube url="panos/img360_1.tiles/%s/l%l/%v/l%l_%s_%v_%h.jpg" multires="512,640,1280" />
		</image>

	</scene>

